# =======================================================================
# Dependencies and Packages
# =======================================================================
# Never commit third-party packages or downloaded modules
node_modules/
bower_components/
vendor/
packages/

# =======================================================================
# Environment Variables & Secrets
# =======================================================================
# Never commit API keys, passwords, or local configuration files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# =======================================================================
# Build Outputs and Caches
# =======================================================================
# Ignore compiled code, build directories, and testing artifacts
dist/
build/
out/
bin/
obj/
target/
.cache/
.parcel-cache/
.next/
.nuxt/
coverage/
*.lcov

# =======================================================================
# Logs and Runtime Data
# =======================================================================
# Prevent standard logs and crash reports from cluttering your repository
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock

# =======================================================================
# IDE and Editor Settings
# =======================================================================
# Ignore files created by VS Code, IntelliJ, WebStorm, Xcode, etc.
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# =======================================================================
# System-Specific Files
# =======================================================================
# Ignore operating system junk files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
